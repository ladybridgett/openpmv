<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MOMENTUM 4"
        android:textColor="#1D1B20"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Not checked"
            android:textColor="#49454F"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—%"
            android:textColor="#49454F"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button android:id="@+id/widget_anc" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="ANC" />
        <Button android:id="@+id/widget_transparency" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Hear" />
        <Button android:id="@+id/widget_off" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Off" />
        <Button android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="44dp" android:text="↻" />
    </LinearLayout>
</LinearLayout>
